{
  "name": "pdf-editor-desktop",
  "productName": "PDF Editor",
  "version": "1.2.0",
  "description": "Edit, sign, convert and recognize text in PDF files, offline.",
  "author": "PDF Editor",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "prepare-app": "node scripts/prepare-app.js",
    "start": "npm run prepare-app && electron .",
    "dist:win": "npm run prepare-app && electron-builder --win",
    "dist:mac": "npm run prepare-app && electron-builder --mac --x64 --arm64",
    "dist:linux": "npm run prepare-app && electron-builder --linux",
    "prepare-app:lite": "node scripts/prepare-app.js --lite",
    "dist:win:lite": "npm run prepare-app:lite && electron-builder --win -c.productName=\"PDF Editor Lite\" -c.appId=com.pdfeditor.lite -c.extraMetadata.name=pdf-editor-lite -c.extraMetadata.productName=\"PDF Editor Lite\" -c.nsis.shortcutName=\"PDF Editor Lite\" -c.nsis.artifactName=\"PDF-Editor-Lite-Setup-\\${version}.exe\" -c.portable.artifactName=\"PDF-Editor-Lite-Portable-\\${version}.exe\" -c.portable.splashImage=build/splash-lite.bmp",
    "start:lite": "npm run prepare-app:lite && electron ."
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.pdfeditor.desktop",
    "productName": "PDF Editor",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "build/icon.png",
      "app/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "description": "PDF document",
        "role": "Editor",
        "mimeType": "application/pdf"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PDF Editor",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "PDF-Editor-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "PDF-Editor-Portable-${version}.exe",
      "splashImage": "build/splash.bmp"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "artifactName": "PDF-Editor-${version}.AppImage"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "artifactName": "PDF-Editor-${version}-${arch}.dmg"
    },
    "publish": null
  }
}
